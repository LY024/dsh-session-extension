{
  "name": "dsh-session-extension",
  "version": "0.7.0",
  "description": "会话管理增强：①在最后一条用户消息下方（复制图标后）点「编辑消息」，文字气泡原地变成可编辑区（已上传的图片/文档附件原地保留），改完把文字送进当前会话输入框直接发送、从当前对话继续，不新建分支；②跨工作区搬会话：会话菜单「移动」（悬停右侧工作区子菜单）、拖到工作区、Ctrl 点击多选批量搬；③删除会话（菜单/多选，事务化、不可恢复）；④批量归档。搬移带崩溃恢复事务，正在打开/正在回答的会话也能搬。",
  "type": "module",
  "main": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./relocate": "./src/relocate.js",
    "./paths": "./src/paths.js",
    "./zstd": "./src/zstd.js",
    "./last-prompt": "./src/last-prompt.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "files": [
    "src",
    "lib",
    "test",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "conversation",
    "edit",
    "edit-message",
    "resend",
    "fork",
    "workspace",
    "move",
    "delete",
    "archive",
    "codex"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LY024/dsh-session-extension.git"
  },
  "bugs": {
    "url": "https://github.com/LY024/dsh-session-extension/issues"
  },
  "homepage": "https://github.com/LY024/dsh-session-extension#readme"
}

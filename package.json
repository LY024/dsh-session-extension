{
  "name": "dsh-session-extension",
  "version": "0.3.0",
  "description": "会话管理增强：①在对话里编辑「上一次提问」后重新发送（类 Codex 的 edit-and-resend，走 DSH 原生 fork，原会话保留），入口是助手消息下方复制图标后面的小图标；②把会话连同日志与工作区归属整体搬到另一个工作区（可自动注册新目录），入口与 dsh-session-relocate 一致：会话菜单的「移动到」、拖动、多选批量、会话页工作区 chip；带崩溃恢复事务，正在打开/正在回答的会话也能搬。",
  "type": "module",
  "main": "src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./relocate": "./src/relocate.js",
    "./paths": "./src/paths.js",
    "./zstd": "./src/zstd.js",
    "./last-prompt": "./src/last-prompt.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "files": [
    "src",
    "lib",
    "test",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "conversation",
    "edit",
    "resend",
    "fork",
    "workspace",
    "move",
    "codex"
  ],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LY024/dsh-session-extension.git"
  },
  "bugs": {
    "url": "https://github.com/LY024/dsh-session-extension/issues"
  },
  "homepage": "https://github.com/LY024/dsh-session-extension#readme"
}
